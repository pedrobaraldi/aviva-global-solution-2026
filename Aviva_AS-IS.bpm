<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://aviva.fiap/bpmn" id="Defs_ASIS">
  <collaboration id="Collab_ASIS"><participant id="Pool_ASIS" name="Aviva — AS-IS" processRef="Proc_ASIS"/></collaboration>
  <process id="Proc_ASIS" name="Aviva AS-IS" isExecutable="false">
    <laneSet id="LS_ASIS">
      <lane id="Lane_ASIS_0" name="Morador (cidadão)">
        <flowNodeRef>ASIS_T3</flowNodeRef>
        <flowNodeRef>ASIS_G2</flowNodeRef>
        <flowNodeRef>ASIS_T4</flowNodeRef>
        <flowNodeRef>ASIS_E2</flowNodeRef>
        <flowNodeRef>ASIS_T5</flowNodeRef>
      </lane>
      <lane id="Lane_ASIS_1" name="Defesa Civil / sistema de alerta atual">
        <flowNodeRef>ASIS_S0</flowNodeRef>
        <flowNodeRef>ASIS_T1</flowNodeRef>
        <flowNodeRef>ASIS_G1</flowNodeRef>
        <flowNodeRef>ASIS_E1</flowNodeRef>
        <flowNodeRef>ASIS_T2</flowNodeRef>
        <flowNodeRef>ASIS_T6</flowNodeRef>
        <flowNodeRef>ASIS_T7</flowNodeRef>
        <flowNodeRef>ASIS_E3</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="ASIS_S0" name="Chuva forte prevista para a região">
      <outgoing>Flow_ASIS_0</outgoing>
    </startEvent>
    <task id="ASIS_T1" name="Monitorar previsão de chuva (Cemaden/INMET)">
      <incoming>Flow_ASIS_0</incoming>
      <outgoing>Flow_ASIS_1</outgoing>
    </task>
    <exclusiveGateway id="ASIS_G1" name="Risco de desastre na região?">
      <incoming>Flow_ASIS_1</incoming>
      <outgoing>Flow_ASIS_2</outgoing>
      <outgoing>Flow_ASIS_3</outgoing>
    </exclusiveGateway>
    <endEvent id="ASIS_E1" name="Fim: nenhum alerta emitido">
      <incoming>Flow_ASIS_2</incoming>
    </endEvent>
    <task id="ASIS_T2" name="Emitir alerta genérico por CEP ou antena (SMS)">
      <incoming>Flow_ASIS_3</incoming>
      <outgoing>Flow_ASIS_4</outgoing>
      <dataOutputAssociation id="DOA_ASIS_T2"><targetRef>DOR_ASIS_D1</targetRef></dataOutputAssociation>
    </task>
    <task id="ASIS_T3" name="Receber o SMS ou perceber a chuva por conta própria">
      <incoming>Flow_ASIS_4</incoming>
      <outgoing>Flow_ASIS_5</outgoing>
    </task>
    <exclusiveGateway id="ASIS_G2" name="Entendeu o aviso e sabe para onde ir?">
      <incoming>Flow_ASIS_5</incoming>
      <outgoing>Flow_ASIS_6</outgoing>
      <outgoing>Flow_ASIS_7</outgoing>
    </exclusiveGateway>
    <task id="ASIS_T4" name="Seguir para local seguro por conta própria">
      <incoming>Flow_ASIS_6</incoming>
      <outgoing>Flow_ASIS_8</outgoing>
    </task>
    <endEvent id="ASIS_E2" name="Fim: morador a salvo (sem orientação oficial)">
      <incoming>Flow_ASIS_8</incoming>
    </endEvent>
    <task id="ASIS_T5" name="Pedir ajuda a vizinhos e ligar para a Defesa Civil (199)">
      <incoming>Flow_ASIS_7</incoming>
      <outgoing>Flow_ASIS_9</outgoing>
    </task>
    <task id="ASIS_T6" name="Registrar chamado por telefone">
      <incoming>Flow_ASIS_9</incoming>
      <outgoing>Flow_ASIS_10</outgoing>
      <dataOutputAssociation id="DOA_ASIS_T6"><targetRef>DOR_ASIS_D2</targetRef></dataOutputAssociation>
    </task>
    <task id="ASIS_T7" name="Enviar equipe de atendimento">
      <incoming>Flow_ASIS_10</incoming>
      <outgoing>Flow_ASIS_11</outgoing>
    </task>
    <endEvent id="ASIS_E3" name="Fim: ocorrência atendida (sem retorno ao alerta)">
      <incoming>Flow_ASIS_11</incoming>
    </endEvent>
    <dataObject id="DO_ASIS_D1" name="Aviso genérico"/>
    <dataObjectReference id="DOR_ASIS_D1" name="Aviso genérico" dataObjectRef="DO_ASIS_D1"/>
    <dataObject id="DO_ASIS_D2" name="Registro do chamado"/>
    <dataObjectReference id="DOR_ASIS_D2" name="Registro do chamado" dataObjectRef="DO_ASIS_D2"/>
    <sequenceFlow id="Flow_ASIS_0" sourceRef="ASIS_S0" targetRef="ASIS_T1"/>
    <sequenceFlow id="Flow_ASIS_1" sourceRef="ASIS_T1" targetRef="ASIS_G1"/>
    <sequenceFlow id="Flow_ASIS_2" sourceRef="ASIS_G1" targetRef="ASIS_E1" name="Não"/>
    <sequenceFlow id="Flow_ASIS_3" sourceRef="ASIS_G1" targetRef="ASIS_T2" name="Sim"/>
    <sequenceFlow id="Flow_ASIS_4" sourceRef="ASIS_T2" targetRef="ASIS_T3"/>
    <sequenceFlow id="Flow_ASIS_5" sourceRef="ASIS_T3" targetRef="ASIS_G2"/>
    <sequenceFlow id="Flow_ASIS_6" sourceRef="ASIS_G2" targetRef="ASIS_T4" name="Sim"/>
    <sequenceFlow id="Flow_ASIS_7" sourceRef="ASIS_G2" targetRef="ASIS_T5" name="Não"/>
    <sequenceFlow id="Flow_ASIS_8" sourceRef="ASIS_T4" targetRef="ASIS_E2"/>
    <sequenceFlow id="Flow_ASIS_9" sourceRef="ASIS_T5" targetRef="ASIS_T6"/>
    <sequenceFlow id="Flow_ASIS_10" sourceRef="ASIS_T6" targetRef="ASIS_T7"/>
    <sequenceFlow id="Flow_ASIS_11" sourceRef="ASIS_T7" targetRef="ASIS_E3"/>
  </process>
  <bpmndi:BPMNDiagram id="Diag_ASIS"><bpmndi:BPMNPlane id="Plane_ASIS" bpmnElement="Collab_ASIS">
    <bpmndi:BPMNShape id="Sh_Pool_ASIS" bpmnElement="Pool_ASIS" isHorizontal="true"><dc:Bounds x="8" y="46" width="1408" height="500"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Sh_Lane_ASIS_0" bpmnElement="Lane_ASIS_0" isHorizontal="true"><dc:Bounds x="38" y="46" width="1378" height="250"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Sh_Lane_ASIS_1" bpmnElement="Lane_ASIS_1" isHorizontal="true"><dc:Bounds x="38" y="296" width="1378" height="250"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Sh_ASIS_S0" bpmnElement="ASIS_S0"><dc:Bounds x="105" y="363" width="38" height="38"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Sh_ASIS_T1" bpmnElement="ASIS_T1"><dc:Bounds x="201" y="344" width="118" height="76"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Sh_ASIS_G1" bpmnElement="ASIS_G1" isMarkerVisible="true"><dc:Bounds x="371" y="357" width="50" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Sh_ASIS_E1" bpmnElement="ASIS_E1"><dc:Bounds x="513" y="455" width="38" height="38"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Sh_ASIS_T2" bpmnElement="ASIS_T2"><dc:Bounds x="473" y="344" width="118" height="76"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Sh_DOR_ASIS_D1" bpmnElement="DOR_ASIS_D1"><dc:Bounds x="476" y="311" width="22" height="28"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Sh_ASIS_T3" bpmnElement="ASIS_T3"><dc:Bounds x="609" y="94" width="118" height="76"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Sh_ASIS_G2" bpmnElement="ASIS_G2" isMarkerVisible="true"><dc:Bounds x="779" y="107" width="50" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Sh_ASIS_T4" bpmnElement="ASIS_T4"><dc:Bounds x="881" y="94" width="118" height="76"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Sh_ASIS_E2" bpmnElement="ASIS_E2"><dc:Bounds x="1057" y="113" width="38" height="38"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Sh_ASIS_T5" bpmnElement="ASIS_T5"><dc:Bounds x="881" y="186" width="118" height="76"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Sh_ASIS_T6" bpmnElement="ASIS_T6"><dc:Bounds x="1017" y="436" width="118" height="76"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Sh_DOR_ASIS_D2" bpmnElement="DOR_ASIS_D2"><dc:Bounds x="1020" y="517" width="22" height="28"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Sh_ASIS_T7" bpmnElement="ASIS_T7"><dc:Bounds x="1153" y="436" width="118" height="76"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Sh_ASIS_E3" bpmnElement="ASIS_E3"><dc:Bounds x="1329" y="455" width="38" height="38"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="Ed_Flow_ASIS_0" bpmnElement="Flow_ASIS_0">
      <di:waypoint x="143" y="382"/>
      <di:waypoint x="201" y="382"/>
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Ed_Flow_ASIS_1" bpmnElement="Flow_ASIS_1">
      <di:waypoint x="319" y="382"/>
      <di:waypoint x="371" y="382"/>
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Ed_Flow_ASIS_2" bpmnElement="Flow_ASIS_2">
      <di:waypoint x="421" y="382"/>
      <di:waypoint x="441" y="382"/>
      <di:waypoint x="441" y="474"/>
      <di:waypoint x="513" y="474"/>
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Ed_Flow_ASIS_3" bpmnElement="Flow_ASIS_3">
      <di:waypoint x="421" y="382"/>
      <di:waypoint x="473" y="382"/>
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Ed_Flow_ASIS_4" bpmnElement="Flow_ASIS_4">
      <di:waypoint x="591" y="382"/>
      <di:waypoint x="600" y="382"/>
      <di:waypoint x="600" y="132"/>
      <di:waypoint x="609" y="132"/>
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Ed_Flow_ASIS_5" bpmnElement="Flow_ASIS_5">
      <di:waypoint x="727" y="132"/>
      <di:waypoint x="779" y="132"/>
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Ed_Flow_ASIS_6" bpmnElement="Flow_ASIS_6">
      <di:waypoint x="829" y="132"/>
      <di:waypoint x="881" y="132"/>
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Ed_Flow_ASIS_7" bpmnElement="Flow_ASIS_7">
      <di:waypoint x="829" y="132"/>
      <di:waypoint x="849" y="132"/>
      <di:waypoint x="849" y="224"/>
      <di:waypoint x="881" y="224"/>
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Ed_Flow_ASIS_8" bpmnElement="Flow_ASIS_8">
      <di:waypoint x="999" y="132"/>
      <di:waypoint x="1057" y="132"/>
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Ed_Flow_ASIS_9" bpmnElement="Flow_ASIS_9">
      <di:waypoint x="999" y="224"/>
      <di:waypoint x="1008" y="224"/>
      <di:waypoint x="1008" y="474"/>
      <di:waypoint x="1017" y="474"/>
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Ed_Flow_ASIS_10" bpmnElement="Flow_ASIS_10">
      <di:waypoint x="1135" y="474"/>
      <di:waypoint x="1153" y="474"/>
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Ed_Flow_ASIS_11" bpmnElement="Flow_ASIS_11">
      <di:waypoint x="1271" y="474"/>
      <di:waypoint x="1329" y="474"/>
    </bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</definitions>