<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://aviva.fiap/bpmn" id="Defs_TOBE">
  <collaboration id="Collab_TOBE"><participant id="Pool_TOBE" name="Aviva — TO-BE" processRef="Proc_TOBE"/></collaboration>
  <process id="Proc_TOBE" name="Aviva TO-BE" isExecutable="false">
    <laneSet id="LS_TOBE">
      <lane id="Lane_TOBE_0" name="Sistema Aviva">
        <flowNodeRef>TOBE_S0</flowNodeRef>
        <flowNodeRef>TOBE_T1</flowNodeRef>
        <flowNodeRef>TOBE_G1</flowNodeRef>
        <flowNodeRef>TOBE_E1</flowNodeRef>
        <flowNodeRef>TOBE_T2</flowNodeRef>
        <flowNodeRef>TOBE_T4</flowNodeRef>
        <flowNodeRef>TOBE_T7</flowNodeRef>
        <flowNodeRef>TOBE_T9</flowNodeRef>
        <flowNodeRef>TOBE_E5</flowNodeRef>
      </lane>
      <lane id="Lane_TOBE_1" name="Defesa Civil">
        <flowNodeRef>TOBE_T3</flowNodeRef>
        <flowNodeRef>TOBE_G2</flowNodeRef>
        <flowNodeRef>TOBE_E2</flowNodeRef>
        <flowNodeRef>TOBE_T8</flowNodeRef>
        <flowNodeRef>TOBE_G4</flowNodeRef>
        <flowNodeRef>TOBE_E4</flowNodeRef>
      </lane>
      <lane id="Lane_TOBE_2" name="Morador (cidadão)">
        <flowNodeRef>TOBE_T5</flowNodeRef>
        <flowNodeRef>TOBE_G3</flowNodeRef>
        <flowNodeRef>TOBE_E3</flowNodeRef>
        <flowNodeRef>TOBE_T6</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="TOBE_S0" name="Início do ciclo de monitoramento (a cada 10 min)">
      <outgoing>Flow_TOBE_0</outgoing>
    </startEvent>
    <serviceTask id="TOBE_T1" name="Monitorar chuva (Cemaden/INMET) e calcular risco por rua">
      <incoming>Flow_TOBE_0</incoming>
      <outgoing>Flow_TOBE_1</outgoing>
    </serviceTask>
    <exclusiveGateway id="TOBE_G1" name="Há ruas em risco?">
      <incoming>Flow_TOBE_1</incoming>
      <outgoing>Flow_TOBE_2</outgoing>
      <outgoing>Flow_TOBE_3</outgoing>
    </exclusiveGateway>
    <endEvent id="TOBE_E1" name="Fim: sem alerta neste ciclo">
      <incoming>Flow_TOBE_2</incoming>
    </endEvent>
    <serviceTask id="TOBE_T2" name="Gerar sugestão de alerta por rua">
      <incoming>Flow_TOBE_3</incoming>
      <outgoing>Flow_TOBE_4</outgoing>
      <dataOutputAssociation id="DOA_TOBE_T2"><targetRef>DOR_TOBE_D1</targetRef></dataOutputAssociation>
    </serviceTask>
    <userTask id="TOBE_T3" name="Revisar a sugestão no painel">
      <incoming>Flow_TOBE_4</incoming>
      <outgoing>Flow_TOBE_5</outgoing>
    </userTask>
    <exclusiveGateway id="TOBE_G2" name="Aprovar o disparo?">
      <incoming>Flow_TOBE_5</incoming>
      <outgoing>Flow_TOBE_6</outgoing>
      <outgoing>Flow_TOBE_7</outgoing>
    </exclusiveGateway>
    <endEvent id="TOBE_E2" name="Fim: sugestão descartada e registrada">
      <incoming>Flow_TOBE_6</incoming>
    </endEvent>
    <serviceTask id="TOBE_T4" name="Enviar alerta (WhatsApp, SMS ou voz) só às ruas em risco">
      <incoming>Flow_TOBE_7</incoming>
      <outgoing>Flow_TOBE_8</outgoing>
    </serviceTask>
    <userTask id="TOBE_T5" name="Receber alerta com orientação e ponto de apoio">
      <incoming>Flow_TOBE_8</incoming>
      <outgoing>Flow_TOBE_9</outgoing>
    </userTask>
    <exclusiveGateway id="TOBE_G3" name="Está em perigo ou viu uma ocorrência?">
      <incoming>Flow_TOBE_9</incoming>
      <outgoing>Flow_TOBE_10</outgoing>
      <outgoing>Flow_TOBE_11</outgoing>
    </exclusiveGateway>
    <endEvent id="TOBE_E3" name="Fim: morador orientado e a salvo">
      <incoming>Flow_TOBE_10</incoming>
    </endEvent>
    <userTask id="TOBE_T6" name="Registrar ocorrência (local, tipo, foto) com gov.br">
      <incoming>Flow_TOBE_11</incoming>
      <outgoing>Flow_TOBE_12</outgoing>
      <dataOutputAssociation id="DOA_TOBE_T6"><targetRef>DOR_TOBE_D2</targetRef></dataOutputAssociation>
    </userTask>
    <serviceTask id="TOBE_T7" name="Registrar o relato e colocar na fila de validação">
      <incoming>Flow_TOBE_12</incoming>
      <outgoing>Flow_TOBE_13</outgoing>
    </serviceTask>
    <userTask id="TOBE_T8" name="Validar o relato (decisão humana)">
      <incoming>Flow_TOBE_13</incoming>
      <outgoing>Flow_TOBE_14</outgoing>
    </userTask>
    <exclusiveGateway id="TOBE_G4" name="Relato válido?">
      <incoming>Flow_TOBE_14</incoming>
      <outgoing>Flow_TOBE_15</outgoing>
      <outgoing>Flow_TOBE_16</outgoing>
    </exclusiveGateway>
    <endEvent id="TOBE_E4" name="Fim: relato arquivado">
      <incoming>Flow_TOBE_15</incoming>
    </endEvent>
    <serviceTask id="TOBE_T9" name="Atualizar o risco e sugerir novo alerta (aprendizado)">
      <incoming>Flow_TOBE_16</incoming>
      <outgoing>Flow_TOBE_17</outgoing>
    </serviceTask>
    <endEvent id="TOBE_E5" name="Fim: ciclo realimentado">
      <incoming>Flow_TOBE_17</incoming>
    </endEvent>
    <dataObject id="DO_TOBE_D1" name="Sugestão de alerta"/>
    <dataObjectReference id="DOR_TOBE_D1" name="Sugestão de alerta" dataObjectRef="DO_TOBE_D1"/>
    <dataObject id="DO_TOBE_D2" name="Relato de ocorrência"/>
    <dataObjectReference id="DOR_TOBE_D2" name="Relato de ocorrência" dataObjectRef="DO_TOBE_D2"/>
    <sequenceFlow id="Flow_TOBE_0" sourceRef="TOBE_S0" targetRef="TOBE_T1"/>
    <sequenceFlow id="Flow_TOBE_1" sourceRef="TOBE_T1" targetRef="TOBE_G1"/>
    <sequenceFlow id="Flow_TOBE_2" sourceRef="TOBE_G1" targetRef="TOBE_E1" name="Não"/>
    <sequenceFlow id="Flow_TOBE_3" sourceRef="TOBE_G1" targetRef="TOBE_T2" name="Sim"/>
    <sequenceFlow id="Flow_TOBE_4" sourceRef="TOBE_T2" targetRef="TOBE_T3"/>
    <sequenceFlow id="Flow_TOBE_5" sourceRef="TOBE_T3" targetRef="TOBE_G2"/>
    <sequenceFlow id="Flow_TOBE_6" sourceRef="TOBE_G2" targetRef="TOBE_E2" name="Não"/>
    <sequenceFlow id="Flow_TOBE_7" sourceRef="TOBE_G2" targetRef="TOBE_T4" name="Sim"/>
    <sequenceFlow id="Flow_TOBE_8" sourceRef="TOBE_T4" targetRef="TOBE_T5"/>
    <sequenceFlow id="Flow_TOBE_9" sourceRef="TOBE_T5" targetRef="TOBE_G3"/>
    <sequenceFlow id="Flow_TOBE_10" sourceRef="TOBE_G3" targetRef="TOBE_E3" name="Não"/>
    <sequenceFlow id="Flow_TOBE_11" sourceRef="TOBE_G3" targetRef="TOBE_T6" name="Sim"/>
    <sequenceFlow id="Flow_TOBE_12" sourceRef="TOBE_T6" targetRef="TOBE_T7"/>
    <sequenceFlow id="Flow_TOBE_13" sourceRef="TOBE_T7" targetRef="TOBE_T8"/>
    <sequenceFlow id="Flow_TOBE_14" sourceRef="TOBE_T8" targetRef="TOBE_G4"/>
    <sequenceFlow id="Flow_TOBE_15" sourceRef="TOBE_G4" targetRef="TOBE_E4" name="Não"/>
    <sequenceFlow id="Flow_TOBE_16" sourceRef="TOBE_G4" targetRef="TOBE_T9" name="Sim"/>
    <sequenceFlow id="Flow_TOBE_17" sourceRef="TOBE_T9" targetRef="TOBE_E5"/>
  </process>
  <bpmndi:BPMNDiagram id="Diag_TOBE"><bpmndi:BPMNPlane id="Plane_TOBE" bpmnElement="Collab_TOBE">
    <bpmndi:BPMNShape id="Sh_Pool_TOBE" bpmnElement="Pool_TOBE" isHorizontal="true"><dc:Bounds x="8" y="46" width="2088" height="750"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Sh_Lane_TOBE_0" bpmnElement="Lane_TOBE_0" isHorizontal="true"><dc:Bounds x="38" y="46" width="2058" height="250"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Sh_Lane_TOBE_1" bpmnElement="Lane_TOBE_1" isHorizontal="true"><dc:Bounds x="38" y="296" width="2058" height="250"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Sh_Lane_TOBE_2" bpmnElement="Lane_TOBE_2" isHorizontal="true"><dc:Bounds x="38" y="546" width="2058" height="250"/></bpmndi:BPMNShape>
